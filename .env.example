# Local / optional overrides
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty for local development.
# GitHub Actions sets this automatically from the Pages URL
# (empty for username.github.io, "/repo-name" for project Pages).
NEXT_PUBLIC_BASE_PATH=

# Optional Formspree/Getform endpoint (otherwise mailto:)
NEXT_PUBLIC_FORM_ENDPOINT=
